{
  "name": "tokilive",
  "productName": "tokilive",
  "version": "1.1.0",
  "description": "tokilive — MD3 风格 B 站直播弹幕悬浮窗",
  "main": "src/main.js",
  "author": "ichiyotsu",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test",
    "dist": "electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.ichiyotsu.tokilive",
    "productName": "tokilive",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/icon.png",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "tokilive-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "tokilive",
      "artifactName": "tokilive-${version}-setup.exe",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ]
    }
  }
}