<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tokilive.InputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="tokilive · 输入">
    <Grid x:Name="Root" Padding="10" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="Box" PlaceholderText="回车发送到当前房间" KeyDown="Box_KeyDown"/>
        <Button Grid.Column="1" Content="锁定位置" Margin="8,0,0,0" Click="Lock_Click"/>
    </Grid>
</Window>
