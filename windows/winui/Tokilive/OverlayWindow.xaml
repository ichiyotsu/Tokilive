<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tokilive.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 1.3.1 用 Viewbox Stretch="Uniform" 把整叠卡片等比缩放，窗口一缩
         字就跟着变小、变糊。1.2.0 的弹幕列表是底部对齐、溢出直接裁掉、
         字号固定不变的，这里改回底部对齐的 StackPanel，不再整体缩放。 -->
    <Grid x:Name="Root" Background="Transparent">
        <!-- #24 顶部渐隐未实现：1.2.0 的 #list 用 -webkit-mask-image 做顶部
             40px 渐隐。WinUI 的 UIElement 没有 OpacityMask（那是 WPF 的），
             之前误写的 <StackPanel.OpacityMask> 会让 XAML 编译直接失败；
             要做只能走 Composition 遮罩，留作已知遗留，先保证编译和发布。 -->
        <StackPanel x:Name="Host" MinWidth="280" MaxWidth="560" Spacing="8" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
        </StackPanel>
    </Grid>
</Window>
