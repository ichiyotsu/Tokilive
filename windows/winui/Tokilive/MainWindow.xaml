<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tokilive.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="tokilive · 设置">
    <!-- 顶栏透明：标题栏由系统单独画的有色条改成内容延伸进标题栏
         （见 NativeWin.ApplyMain），这一行就是那条顶栏——背景透明，
         Mica / Acrylic 直接透出来，上面只放标题文字，不加任何实色条。
         NavigationView 放在第二行，顶栏不会盖住它的内容和菜单按钮。 -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="TitleBarRow" Background="Transparent" PointerPressed="TitleBarRow_PointerPressed">
            <TextBlock Text="tokilive · 设置" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
        </Grid>
        <NavigationView Grid.Row="1" x:Name="Nav" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" PaneDisplayMode="Auto" SelectionChanged="Nav_SelectionChanged" OpenPaneLength="200" CompactPaneLength="48">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="连接" Tag="conn"><NavigationViewItem.Icon><SymbolIcon Symbol="Link"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="弹幕面板" Tag="danmaku"><NavigationViewItem.Icon><SymbolIcon Symbol="Message"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="实时窗" Tag="live"><NavigationViewItem.Icon><SymbolIcon Symbol="View"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="歌词" Tag="lyrics"><NavigationViewItem.Icon><SymbolIcon Symbol="Audio"/></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="窗口源" Tag="source"><NavigationViewItem.Icon><SymbolIcon Symbol="SlideShow"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="设置" Tag="settings"><NavigationViewItem.Icon><SymbolIcon Symbol="Setting"/></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid>
                <ScrollViewer x:Name="PageConn" Padding="{StaticResource PagePadding}">
                    <StackPanel Spacing="12" MaxWidth="760">
                        <TextBlock Text="连接" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="AccountText" Style="{ThemeResource BodyTextBlockStyle}"/>
                        <TextBox x:Name="RoomBox" Header="房间号" PlaceholderText="直播间号"/>
                        <!-- 窗口拖窄时这四个按钮横着排不下，包一层横向滚动，别被裁掉。 -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="连接" Click="Connect_Click"/>
                            <Button Content="断开" Click="Disconnect_Click"/>
                            <Button Content="读取我的直播间" Click="OwnRoom_Click"/>
                            <Button Content="扫码登录" Click="Qr_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Image x:Name="QrImage" Width="200" Height="200" Visibility="Collapsed"/>
                        <TextBlock Text="扫码只把 Cookie 留在本机配置里，不会写入仓库或日志。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBox x:Name="CookieBox" Header="Cookie（手动粘贴，SESSDATA=… 这样一整串）" PlaceholderText="SESSDATA=…; bili_jct=…; DedeUserID=…"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="保存 Cookie" Click="SaveCookie_Click"/>
                            <Button Content="退出登录" Click="Logout_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="PageDanmaku" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Padding="{StaticResource PagePadding}">
                        <StackPanel Spacing="8" MaxWidth="880">
                            <TextBlock Text="弹幕面板" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <TextBlock Text="这一页只有一个预览。下面的分组改的是同一块预览和真正的悬浮窗。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <Border x:Name="Preview" MinHeight="140" Padding="12" CornerRadius="12" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel x:Name="PreviewList" Spacing="8"/>
                            </Border>
                            <!-- 预览背景：1.2.0 settings.html 的 BGS 四项（棋盘格/白/深色/渐变），
                                 只改预览这一块的底，不改真正的悬浮窗。默认棋盘格。 -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="预览背景：" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Content="棋盘格" Tag="0" Click="PreviewBg_Click"/>
                                <Button Content="白色" Tag="1" Click="PreviewBg_Click"/>
                                <Button Content="深色" Tag="2" Click="PreviewBg_Click"/>
                                <Button Content="渐变" Tag="3" Click="PreviewBg_Click"/>
                            </StackPanel>
                            </ScrollViewer>
                            <!-- 窗口拖窄时 9 个预设按钮横着排不下，包一层横向滚动，别被裁掉。 -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="默认" Tag="默认" Click="Preset_Click"/>
                                <Button Content="紧凑" Tag="紧凑" Click="Preset_Click"/>
                                <Button Content="极简" Tag="极简" Click="Preset_Click"/>
                                <Button Content="霓虹" Tag="霓虹" Click="Preset_Click"/>
                                <Button Content="纯文字" Tag="纯文字" Click="Preset_Click"/>
                                <Button Content="大字" Tag="大字" Click="Preset_Click"/>
                                <Button Content="安静" Tag="安静" Click="Preset_Click"/>
                                <Button Content="导出主题" Click="ExportTheme_Click"/>
                                <Button Content="导入主题" Click="ImportTheme_Click"/>
                            </StackPanel>
                            </ScrollViewer>
                            <Expander Header="头像与颜色" IsExpanded="True">
                                <StackPanel Spacing="8">
                                    <ToggleSwitch x:Name="AvatarSwitch" Header="显示头像" OnContent="开" OffContent="关"/>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <!-- 1.2.0 是原生 <input type="color">，1.3.1 只剩手打 hex 的文本框，
                                             打错就悄悄回退到 #1A1A1A。每个颜色框旁边加一个色块按钮，
                                             点开 Flyout 里的 ColorPicker 选色，写回文本框。 -->
                                        <Grid Grid.Column="0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="NameColorBox" Header="名字颜色"/>
                                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" MinWidth="36" MinHeight="32" Padding="4" ToolTipService.ToolTip="选名字颜色">
                                                <Button.Flyout><Flyout><ColorPicker x:Name="NameColorPicker" Tag="NameColorBox" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                                <Border x:Name="NameColorSwatch" Width="20" Height="20" CornerRadius="4" Background="#7C4DFF"/>
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Column="1">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="CardColorBox" Header="卡片颜色"/>
                                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" MinWidth="36" MinHeight="32" Padding="4" ToolTipService.ToolTip="选卡片颜色">
                                                <Button.Flyout><Flyout><ColorPicker x:Name="CardColorPicker" Tag="CardColorBox" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                                <Border x:Name="CardColorSwatch" Width="20" Height="20" CornerRadius="4" Background="#F5F5F5"/>
                                            </Button>
                                        </Grid>
                                        <Grid Grid.Column="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="TextColorBox" Header="文字颜色"/>
                                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" MinWidth="36" MinHeight="32" Padding="4" ToolTipService.ToolTip="选文字颜色">
                                                <Button.Flyout><Flyout><ColorPicker x:Name="TextColorPicker" Tag="TextColorBox" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                                <Border x:Name="TextColorSwatch" Width="20" Height="20" CornerRadius="4" Background="#1A1A1A"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                    <!-- 窗口拖窄时 8 个色块横着排不下，包一层横向滚动，别被裁掉。 -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="文字颜色快捷：" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <Button Tag="#1A1A1A" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#1A1A1A"><Border Width="20" Height="20" CornerRadius="4" Background="#1A1A1A"/></Button>
                                        <Button Tag="#FFFFFF" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#FFFFFF"><Border Width="20" Height="20" CornerRadius="4" Background="#FFFFFF"/></Button>
                                        <Button Tag="#7C4DFF" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#7C4DFF"><Border Width="20" Height="20" CornerRadius="4" Background="#7C4DFF"/></Button>
                                        <Button Tag="#FF5FC8" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#FF5FC8"><Border Width="20" Height="20" CornerRadius="4" Background="#FF5FC8"/></Button>
                                        <Button Tag="#C9B46E" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#C9B46E"><Border Width="20" Height="20" CornerRadius="4" Background="#C9B46E"/></Button>
                                        <Button Tag="#2A60B2" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#2A60B2"><Border Width="20" Height="20" CornerRadius="4" Background="#2A60B2"/></Button>
                                        <Button Tag="#2FB344" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#2FB344"><Border Width="20" Height="20" CornerRadius="4" Background="#2FB344"/></Button>
                                        <Button Tag="#E5484D" Click="TextColorChip_Click" MinWidth="28" MinHeight="28" Padding="0" ToolTipService.ToolTip="#E5484D"><Border Width="20" Height="20" CornerRadius="4" Background="#E5484D"/></Button>
                                    </StackPanel>
                                    </ScrollViewer>
                                </StackPanel>
                            </Expander>
                            <Expander Header="停留、数量与主题" IsExpanded="True">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <NumberBox x:Name="LifetimeBox" Grid.Column="0" Header="弹幕停留（秒，0=不消失）" Minimum="0" Maximum="3600" SpinButtonPlacementMode="Inline"/>
                                        <NumberBox x:Name="MaxMessagesBox" Grid.Column="1" Header="最多保留条数" Minimum="1" Maximum="200" SpinButtonPlacementMode="Inline"/>
                                    </Grid>
                                    <ComboBox x:Name="FontWeightBox" Header="弹幕字重" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="400" Tag="400"/>
                                        <ComboBoxItem Content="500" Tag="500"/>
                                        <ComboBoxItem Content="600" Tag="600"/>
                                        <ComboBoxItem Content="700" Tag="700"/>
                                        <ComboBoxItem Content="800" Tag="800"/>
                                    </ComboBox>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Slider x:Name="TextShadowSlider" Grid.Column="0" Header="文字阴影" Minimum="0" Maximum="1" StepFrequency="0.05"/>
                                        <Slider x:Name="CardBlurSlider" Grid.Column="1" Header="卡片磨砂" Minimum="0" Maximum="40"/>
                                    </Grid>
                                    <ComboBox x:Name="CardThemeBox" Header="卡片主题" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="跟随系统" Tag="system"/>
                                        <ComboBoxItem Content="浅色" Tag="light"/>
                                        <ComboBoxItem Content="深色" Tag="dark"/>
                                        <ComboBoxItem Content="透明" Tag="transparent"/>
                                    </ComboBox>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox x:Name="SeedColorBox" Header="种子色（礼物/上舰/醒目留言等卡片的配色来源）"/>
                                        <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" MinWidth="36" MinHeight="32" Padding="4" ToolTipService.ToolTip="选种子色">
                                            <Button.Flyout><Flyout><ColorPicker x:Name="SeedColorPicker" Tag="SeedColorBox" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                            <Border x:Name="SeedColorSwatch" Width="20" Height="20" CornerRadius="4" Background="#6750A4"/>
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <ToggleSwitch x:Name="ShowMedalSwitch" Header="显示粉丝牌" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="ScBiliColorSwitch" Header="醒目留言用 B 站底色" OnContent="开" OffContent="关"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <ComboBox x:Name="MedalStyleBox" Header="粉丝牌样式" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="统一" Tag="unified"/>
                                                <ComboBoxItem Content="B 站" Tag="bilibili"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <TextBox x:Name="CjkFontBox" Header="中文字体"/>
                                    <ComboBox x:Name="CjkFontPicker" Header="常用字体（点一下填入上面，可再手动改）" HorizontalAlignment="Stretch" SelectionChanged="CjkFontPicker_SelectionChanged"/>
                                    <TextBox x:Name="JpFontBox" Header="日文字体"/>
                                    <ComboBox x:Name="JpFontPicker" Header="常用字体（点一下填入上面，可再手动改）" HorizontalAlignment="Stretch" SelectionChanged="JpFontPicker_SelectionChanged"/>
                                    <NumberBox x:Name="MinGiftPriceBox" Header="最低礼物价（元，0=不过滤）" Minimum="0" Maximum="100000" SpinButtonPlacementMode="Inline"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="文字" IsExpanded="True">
                                <StackPanel Spacing="8">
                                    <TextBox x:Name="CardFontBox" Header="字体"/>
                                    <ComboBox x:Name="CardFontPicker" Header="常用字体（点一下填入上面，可再手动改）" HorizontalAlignment="Stretch" SelectionChanged="CardFontPicker_SelectionChanged"/>
                                    <ToggleSwitch x:Name="AdaptiveSwitch" Header="文字颜色自适应" OnContent="开" OffContent="关"/>
                                    <TextBlock Text="默认关闭。打开后大约每 2 秒把悬浮窗藏起一瞬，采样它挡住的那一块屏幕。不上传。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="字号、圆角与边框" IsExpanded="True">
                                <StackPanel Spacing="8">
                                    <Grid ColumnSpacing="12" RowSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Slider x:Name="FontSlider" Grid.Column="0" Header="字号" Minimum="12" Maximum="32"/>
                                        <Slider x:Name="CornerSlider" Grid.Column="1" Header="圆角" Minimum="0" Maximum="28"/>
                                        <Slider x:Name="OpacitySlider" Grid.Column="0" Grid.Row="1" Header="卡片不透明度" Minimum="0.2" Maximum="1" StepFrequency="0.05"/>
                                    </Grid>
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <ToggleSwitch x:Name="BorderSwitch" Header="窗口边框（强调色）" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="GameTopSwitch" Header="实验性游戏置顶" OnContent="开" OffContent="关"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <ToggleSwitch x:Name="ClickSwitch" Header="鼠标穿透" OnContent="开" OffContent="关"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="只反复把 tokilive 自己的窗口抬到普通置顶层，设置窗口仍然在悬浮窗上面。不注入游戏，也不保证盖住独占全屏。无边框窗口化更有机会。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="弹幕动画" IsExpanded="True">
                                <StackPanel Spacing="8">
                                    <ToggleSwitch x:Name="AnimSwitch" Header="弹幕动画" OnContent="开" OffContent="关"/>
                                    <ComboBox x:Name="AnimBox" Header="动画预设" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="默认" Tag="default"/>
                                        <ComboBoxItem Content="模糊" Tag="blur"/>
                                        <ComboBoxItem Content="弹出" Tag="pop"/>
                                        <ComboBoxItem Content="缓慢上升" Tag="rise"/>
                                        <ComboBoxItem Content="逐字显示" Tag="type"/>
                                    </ComboBox>
                                    <Slider x:Name="AnimSpeedSlider" Header="动画速度" Minimum="0.5" Maximum="2" StepFrequency="0.1"/>
                                    <TextBlock Text="只给新弹幕播入场动画，旧弹幕不会因为刷新重播。关闭或选默认时，新弹幕直接出现，和现在一样。速度 0.5x 最慢、2x 最快。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="显示的消息" IsExpanded="True">
                                <StackPanel Spacing="8">
                                    <!-- 1.3.1 是 8 个开关竖着一行一个，占了大半页。
                                         改成两列，4 行放完，意思和开关状态都不变。 -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Spacing="8">
                                            <ToggleSwitch x:Name="MsgDanmaku" Header="弹幕" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="MsgGift" Header="礼物" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="MsgSc" Header="醒目留言" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="MsgGuard" Header="上舰" OnContent="开" OffContent="关"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="8">
                                            <ToggleSwitch x:Name="MsgEnter" Header="进场" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="MsgFollow" Header="关注" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="MsgLike" Header="点赞" OnContent="开" OffContent="关"/>
                                            <ToggleSwitch x:Name="MsgShare" Header="分享" OnContent="开" OffContent="关"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="进场、关注、点赞和分享进实时窗。弹幕、礼物、醒目留言和上舰进弹幕窗。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Expander>
                            <Expander Header="输入与语音" IsExpanded="True">
                                <StackPanel Spacing="8">
                                    <TextBox x:Name="HotkeyBox" Header="打开输入窗的快捷键"/>
                                    <TextBlock Text="单独的 / 只在没有其他输入光标时才会被拿走，避免在游戏和文本框里永远吞掉斜杠。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ToggleSwitch x:Name="TtsSwitch" Header="语音播报" OnContent="开" OffContent="关"/>
                                    <ComboBox x:Name="VoiceBox" Header="语音" HorizontalAlignment="Stretch"/>
                                    <Slider x:Name="RateSlider" Header="语速" Minimum="0.5" Maximum="2" StepFrequency="0.1"/>
                                    <Slider x:Name="VolumeSlider" Header="音量" Minimum="0" Maximum="1" StepFrequency="0.05"/>
                                    <Button Content="试听" Click="PreviewSpeech_Click"/>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="16" Padding="6" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="TestBar" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" PointerWheelChanged="TestBar_Wheel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Content="测试弹幕" Tag="danmaku" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                                <Button Content="测试表情" Tag="emote" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                                <Button Content="测试礼物" Tag="gift" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                                <Button Content="测试醒目留言" Tag="superchat" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                                <Button Content="测试上舰" Tag="guard" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                                <Button Content="测试进场" Tag="enter" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                                <Button Content="测试关注" Tag="follow" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                                <Button Content="测试点赞" Tag="like" Click="Test_Click" MinHeight="28" Padding="10,4" FontSize="13"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="PageLive" Visibility="Collapsed" Padding="{StaticResource PagePadding}">
                    <StackPanel Spacing="12" MaxWidth="760">
                        <TextBlock Text="实时窗" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <ToggleSwitch x:Name="LiveSwitch" Header="显示实时窗" OnContent="开" OffContent="关"/>
                        <ToggleSwitch x:Name="LiveBorderSwitch" Header="实时窗边框（强调色）" OnContent="开" OffContent="关"/>
                        <TextBlock Text="点赞、弹幕数、在线和看过人数。隐藏不断开连接。预览和悬浮窗用同一份数字。" TextWrapping="Wrap"/>
                        <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock x:Name="LivePreview" TextWrapping="Wrap"/>
                        </Border>
                        <ToggleSwitch x:Name="MiniStatsSwitch" Header="显示数据栏" OnContent="开" OffContent="关"/>
                        <ComboBox x:Name="MiniLayoutBox" Header="数据栏布局" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="横条" Tag="h"/>
                            <ComboBoxItem Content="竖条" Tag="v"/>
                            <ComboBoxItem Content="自动" Tag="auto"/>
                        </ComboBox>
                        <ToggleSwitch x:Name="MiniPillsSwitch" Header="实时窗里显示互动气泡" OnContent="开" OffContent="关"/>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <NumberBox x:Name="MiniLifetimeBox" Grid.Column="0" Header="互动停留（秒，0=不消失）" Minimum="0" Maximum="3600" SpinButtonPlacementMode="Inline"/>
                            <NumberBox x:Name="MiniMaxBox" Grid.Column="1" Header="互动最多条数" Minimum="1" Maximum="20" SpinButtonPlacementMode="Inline"/>
                        </Grid>
                        <TextBlock Text="进场、关注、点赞、分享去哪里：" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <ComboBox x:Name="RouteEnterBox" Grid.Column="0" Header="进场" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="实时窗" Tag="mini"/>
                                <ComboBoxItem Content="弹幕窗" Tag="main"/>
                                <ComboBoxItem Content="关闭" Tag="off"/>
                            </ComboBox>
                            <ComboBox x:Name="RouteFollowBox" Grid.Column="1" Header="关注" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="实时窗" Tag="mini"/>
                                <ComboBoxItem Content="弹幕窗" Tag="main"/>
                                <ComboBoxItem Content="关闭" Tag="off"/>
                            </ComboBox>
                            <ComboBox x:Name="RouteShareBox" Grid.Column="0" Grid.Row="1" Header="分享" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="实时窗" Tag="mini"/>
                                <ComboBoxItem Content="弹幕窗" Tag="main"/>
                                <ComboBoxItem Content="关闭" Tag="off"/>
                            </ComboBox>
                            <ComboBox x:Name="RouteLikeBox" Grid.Column="1" Grid.Row="1" Header="点赞" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="实时窗" Tag="mini"/>
                                <ComboBoxItem Content="弹幕窗" Tag="main"/>
                                <ComboBoxItem Content="关闭" Tag="off"/>
                            </ComboBox>
                        </Grid>
                        <TextBlock Text="实时窗迷你预览（数据栏横条）：" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <Border Padding="12" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <TextBlock x:Name="MiniPreviewText" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="PageLyrics" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer Padding="24,16,24,12">
                        <StackPanel Spacing="8" MaxWidth="760">
                            <TextBlock Text="歌词" Style="{ThemeResource TitleTextBlockStyle}"/>
                            <TextBlock Text="通过 Windows 系统媒体会话读取正在播放的曲目和时间轴，优先标出 QQ 音乐和网易云。不读播放器数据库，也不注入进程。没有时间轴就不会编造逐字时间。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <!-- 设计是预设不是锁定：选一个设计会把它的字体、颜色、字号、
                                 粗细、阴影、描边、底色和对齐一次写进下面的控件，之后
                                 再改单项也不会把设计改回去。 -->
                            <ComboBox x:Name="LyricDesignBox" Header="歌词设计" HorizontalAlignment="Stretch" SelectionChanged="LyricDesignBox_SelectionChanged"/>
                            <ToggleSwitch x:Name="DesktopLyricsSwitch" Header="桌面歌词" OnContent="开" OffContent="关"/>
                            <ToggleSwitch x:Name="LyricDemoSwitch" Header="演示排版" OnContent="开" OffContent="关"/>
                            <TextBox x:Name="LyricFontBox" Header="字体"/>
                            <ComboBox x:Name="LyricFontPicker" Header="常用字体（点一下填入上面，可再手动改）" HorizontalAlignment="Stretch" SelectionChanged="LyricFontPicker_SelectionChanged"/>
                            <Slider x:Name="LyricSizeSlider" Header="字号" Minimum="16" Maximum="64"/>
                            <ComboBox x:Name="LyricWeightBox" Header="粗细" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="细" Tag="light"/>
                                <ComboBoxItem Content="常规" Tag="normal"/>
                                <ComboBoxItem Content="粗" Tag="bold"/>
                                <ComboBoxItem Content="特粗" Tag="black"/>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="LyricColorBox" Header="文字颜色"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" MinWidth="36" MinHeight="32" Padding="4" ToolTipService.ToolTip="选歌词文字颜色">
                                    <Button.Flyout><Flyout><ColorPicker x:Name="LyricColorPicker" Tag="LyricColorBox" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                    <Border x:Name="LyricColorSwatch" Width="20" Height="20" CornerRadius="4" Background="#FFFFFF"/>
                                </Button>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="LyricHiBox" Header="当前行颜色"/>
                                <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" MinWidth="36" MinHeight="32" Padding="4" ToolTipService.ToolTip="选歌词当前行颜色">
                                    <Button.Flyout><Flyout><ColorPicker x:Name="LyricHiPicker" Tag="LyricHiBox" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                    <Border x:Name="LyricHiSwatch" Width="20" Height="20" CornerRadius="4" Background="#FFFFFF"/>
                                </Button>
                            </Grid>
                            <ComboBox x:Name="LyricAlignBox" Header="对齐" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="left"/><ComboBoxItem Content="center"/><ComboBoxItem Content="right"/>
                            </ComboBox>
                            <ToggleSwitch x:Name="LyricShadowSwitch" Header="阴影" OnContent="开" OffContent="关"/>
                            <ToggleSwitch x:Name="LyricOutlineSwitch" Header="描边" OnContent="开" OffContent="关"/>
                            <Slider x:Name="LyricBgSlider" Header="底色不透明度" Minimum="0" Maximum="0.8" StepFrequency="0.05"/>
                            <!-- 旧的行数滑杆（1-5）改成单行/双行：以前 TakeLast 是取全曲
                                 最后几行，行数一多就显示歌的结尾；现在单行只显示当前行，
                                 双行是当前行 + 翻译（没有翻译就显示下一行）。 -->
                            <ComboBox x:Name="LyricModeBox" Header="行数" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="单行" Tag="single"/>
                                <ComboBoxItem Content="双行" Tag="double"/>
                            </ComboBox>
                            <ComboBox x:Name="LyricDirectionBox" Header="排列" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="横排" Tag="horizontal"/>
                                <ComboBoxItem Content="竖排" Tag="vertical"/>
                            </ComboBox>
                            <ToggleSwitch x:Name="LyricClickSwitch" Header="桌面歌词穿透" OnContent="开" OffContent="关"/>
                            <ToggleSwitch x:Name="LyricLockSwitch" Header="锁定位置" OnContent="开" OffContent="关"/>
                            <Slider x:Name="LyricOffsetSlider" Header="时间偏移（秒）" Minimum="-10" Maximum="10" StepFrequency="0.1"/>
                            <Button Content="导入 LRC / TTML" Click="ImportLyrics_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="1" Margin="24,0,24,16" Padding="16" CornerRadius="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PlayerTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PlayerArtist" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="PlayerLine" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PlayerTime" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <Button Content="上一首" Tag="prev" Click="LyricControl_Click"/>
                                <Button Content="播放" Tag="play" Click="LyricControl_Click"/>
                                <Button Content="暂停" Tag="pause" Click="LyricControl_Click"/>
                                <Button Content="切换播放" Tag="toggle" Click="LyricControl_Click"/>
                                <Button Content="下一首" Tag="next" Click="LyricControl_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
                <ScrollViewer x:Name="PageSource" Visibility="Collapsed" Padding="{StaticResource PagePadding}">
                    <StackPanel Spacing="12" MaxWidth="760">
                        <TextBlock Text="窗口源" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <ToggleSwitch x:Name="DanmakuWindowSwitch" Header="显示弹幕窗" OnContent="开" OffContent="关"/>
                        <ToggleSwitch x:Name="TaskbarSwitch" Header="在任务栏隐藏" OnContent="开" OffContent="关"/>
                        <Button Content="重置窗口位置" Click="ResetBounds_Click"/>
                        <TextBlock Text="窗口仍在托盘里。托盘创建失败时会留下任务栏按钮，避免程序消失。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ToggleSwitch x:Name="ObsSwitch" Header="启用本地浏览器源" OnContent="开" OffContent="关"/>
                        <NumberBox x:Name="PortBox" Header="端口" Minimum="1024" Maximum="65535" SpinButtonPlacementMode="Inline"/>
                        <TextBox x:Name="OverlayUrl" Header="弹幕地址" IsReadOnly="True"/>
                        <TextBox x:Name="MiniUrl" Header="实时窗地址" IsReadOnly="True"/>
                        <TextBlock Text="标题分别是「tokilive · 弹幕」和「tokilive · 实时窗」。透明窗口在传统窗口捕获里常常是捕不到的。浏览器源是保持透明的办法。这里没有用真实的 OBS 核对过画面。" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" Padding="{StaticResource PagePadding}">
                    <StackPanel Spacing="12" MaxWidth="760">
                        <TextBlock Text="外观" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="只改变这个设置窗口。弹幕卡片颜色不跟着变。浅色和深色都使用系统画笔，避免浅色模式下字和底色糊在一起。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ComboBox x:Name="ThemeBox" Header="主题" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="浅色"/><ComboBoxItem Content="深色"/>
                        </ComboBox>
                        <ToggleSwitch x:Name="AccentSwitch" Header="使用 Windows 强调色" OnContent="开" OffContent="关"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="AccentBox" Header="自定义强调色（读不到系统色时使用）"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Bottom" MinWidth="36" MinHeight="32" Padding="4" ToolTipService.ToolTip="选自定义强调色">
                                <Button.Flyout><Flyout><ColorPicker x:Name="AccentPicker" Tag="AccentBox" IsAlphaEnabled="False" IsHexInputVisible="True" ColorChanged="ColorPicker_ColorChanged"/></Flyout></Button.Flyout>
                                <Border x:Name="AccentSwatch" Width="20" Height="20" CornerRadius="4" Background="#6750A4"/>
                            </Button>
                        </Grid>
                        <ComboBox x:Name="AdaptiveManualBox" Header="自适应采样失败时的文字颜色" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="浅色" Tag="light"/>
                            <ComboBoxItem Content="深色" Tag="dark"/>
                        </ComboBox>
                        <ComboBox x:Name="AppMaterialBox" Header="设置窗口材质" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Mica" Tag="mica"/>
                            <ComboBoxItem Content="Acrylic" Tag="acrylic"/>
                            <ComboBoxItem Content="Mica Alt（标签页风格）" Tag="tabbed"/>
                            <ComboBoxItem Content="无（纯色）" Tag="none"/>
                        </ComboBox>
                        <TextBlock x:Name="AppBackgroundText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="选择背景图片" Click="PickBackground_Click"/>
                            <Button Content="清除背景" Click="ClearBackground_Click"/>
                        </StackPanel>
                        </ScrollViewer>
                        <Slider x:Name="AppBgOpacitySlider" Header="背景图不透明度" Minimum="0" Maximum="1" StepFrequency="0.05"/>
                        <ComboBox x:Name="SidebarModeBox" Header="左侧导航栏" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="自动" Tag="auto"/>
                            <ComboBoxItem Content="展开" Tag="left"/>
                            <ComboBoxItem Content="收起" Tag="leftcompact"/>
                        </ComboBox>
                        <TextBox x:Name="LockHotkeyBox" Header="锁定窗口快捷键（例如 Control+Shift+L，留空则不注册）"/>
                        <TextBlock x:Name="MaterialText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="更新" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock x:Name="UpdateText" TextWrapping="Wrap"/>
                        <Button Content="检查更新" Click="Update_Click"/>
                        <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Minimum="0" Maximum="100"/>
                        <TextBlock x:Name="UpdateProgressText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Expander x:Name="UpdateNotesExpander" Header="新版说明" Visibility="Collapsed" HorizontalAlignment="Stretch">
                            <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            </ScrollViewer>
                        </Expander>
                        <TextBlock Text="关于" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="1.3.1" Style="{ThemeResource TitleTextBlockStyle}"/>
                        <TextBlock Text="原生 WinUI 3，未打包，Windows 10 1809 和 Windows 11。应用 ID com.ichiyotsu.tokilive。" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
    </Grid>
</Window>
