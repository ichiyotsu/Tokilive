<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tokilive.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 启动画面：用户提供的启动图（白框圆角卡片 + 极光渐变 + 发光字标），
         只取白框内的内容，白框线就是窗口的边。图片以嵌入资源打包，
         四角透明；窗口无边框、透明底。进场淡入 + 0.86 倍缩放（.55s），
         约 2 秒后淡出 + 0.94 倍缩放（.3s），和 1.2.0 的节奏一致。 -->
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Card" Background="Transparent">
            <Image x:Name="SplashImage" Stretch="Fill"/>
        </Border>
    </Grid>
</Window>
